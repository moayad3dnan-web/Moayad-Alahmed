me": "جبنة عربية بزيت الزيتون", "price": 16, "cat": "coldApp"}, {"id": "c11", "name": "متبل باذنجان مشوي", "price": 17, "cat": "coldApp"}, {"id": "c12", "name": "حمص بزيت الزيتون والصنوبر", "price": 16, "cat": "coldApp"}, {"id": "c13", "name": "زيتون متبل", "price": 11, "cat": "coldApp"}, {"id": "c14", "name": "حلوم بارد بالزعتر", "price": 19, "cat": "coldApp"}, {"id": "c15", "name": "فتة حمص باللبن", "price": 18, "cat": "coldApp"}, {"id": "c16", "name": "جبن قريش بالطماطم", "price": 15, "cat": "coldApp"}, {"id": "c1", "name": "زبادي بالخيار", "price": 15, "cat": "salads"}, {"id": "c2", "name": "سلطة خليجية بالطحينة", "price": 18, "cat": "salads"}, {"id": "c3", "name": "سلطة دقوس", "price": 16, "cat": "salads"}, {"id": "c4", "name": "سلطة جرجير بالرمان", "price": 20, "cat": "salads"}, {"id": "c6", "name": "سلطة الطماطم والخيار", "price": 14, "cat": "salads"}, {"id": "c8", "name": "سلطة الفجل والجزر", "price": 14, "cat": "salads"}, {"id": "s7", "name": "سلطة خضراء بزيت الزيتون", "price": 15, "cat": "salads"}, {"id": "s8", "name": "سلطة الكرنب بالليمون", "price": 13, "cat": "salads"}, {"id": "s9", "name": "سلطة الذرة والفلفل الحلو", "price": 15, "cat": "salads"}, {"id": "s10", "name": "سلطة الخس بصوص الطحينة", "price": 14, "cat": "salads"}, {"id": "cd1", "name": "عصير برتقال طازج", "price": 14, "cat": "coldDrinks"}, {"id": "cd2", "name": "ليموناضة بالنعناع", "price": 15, "cat": "coldDrinks"}, {"id": "cd3", "name": "لبن بارد", "price": 12, "cat": "coldDrinks"}, {"id": "cd5", "name": "شاي مثلج", "price": 13, "cat": "coldDrinks"}, {"id": "cd6", "name": "عصير تمر هندي", "price": 14, "cat": "coldDrinks"}, {"id": "cd7", "name": "عصير رمان", "price": 16, "cat": "coldDrinks"}, {"id": "cd8", "name": "سوبيا", "price": 13, "cat": "coldDrinks"}, {"id": "cd9", "name": "عصير مانجو", "price": 15, "cat": "coldDrinks"}, {"id": "cd10", "name": "شعير بارد", "price": 12, "cat": "coldDrinks"}, {"id": "hd1", "name": "قهوة عربية", "price": 12, "cat": "hotDrinks"}, {"id": "hd2", "name": "شاي كرك", "price": 10, "cat": "hotDrinks"}, {"id": "hd3", "name": "شاي أحمر", "price": 9, "cat": "hotDrinks"}, {"id": "hd4", "name": "شاي بالهيل", "price": 11, "cat": "hotDrinks"}, {"id": "hd5", "name": "حليب بالزعفران", "price": 16, "cat": "hotDrinks"}, {"id": "hd6", "name": "قهوة تركية", "price": 13, "cat": "hotDrinks"}, {"id": "hd7", "name": "شاي بالنعناع", "price": 9, "cat": "hotDrinks"}, {"id": "hd8", "name": "سحلب", "price": 15, "cat": "hotDrinks"}, {"id": "hd9", "name": "قهوة بالزعفران", "price": 14, "cat": "hotDrinks"}, {"id": "hd10", "name": "زنجبيل بالعسل", "price": 11, "cat": "hotDrinks"}, {"id": "d1", "name": "لقيمات", "price": 20, "cat": "dessert"}, {"id": "d2", "name": "خبيصة", "price": 19, "cat": "dessert"}, {"id": "d3", "name": "بثيث", "price": 18, "cat": "dessert"}, {"id": "d4", "name": "مهلبية بالزعفران", "price": 17, "cat": "dessert"}, {"id": "d5", "name": "معصوب", "price": 21, "cat": "dessert"}, {"id": "d6", "name": "عصيدة", "price": 17, "cat": "dessert"}, {"id": "d7", "name": "سمبوسة حلا بالقشطة", "price": 18, "cat": "dessert"}, {"id": "d8", "name": "خبيص الرز", "price": 16, "cat": "dessert"}, {"id": "d9", "name": "زلابيا", "price": 17, "cat": "dessert"}, {"id": "d10", "name": "كليجا", "price": 19, "cat": "dessert"}];
  const CAT_LABELS = {"bundles": "👨‍👩‍👧‍👦 باقات العائلة", "main": "🍛 الأطباق الرئيسية", "hotApp": "🔥 مقبلات ساخنة", "coldApp": "🥗 مقبلات باردة", "salads": "🥬 سلطات", "coldDrinks": "🧊 مشروبات باردة", "hotDrinks": "☕ مشروبات ساخنة", "dessert": "🍰 حلويات"};
  const CAT_ORDER = ["bundles", "main", "hotApp", "coldApp", "salads", "coldDrinks", "hotDrinks", "dessert"];

  let overrides = {};
  let saveTimer = null;

  function setStatus(text, cls){
    const el = document.getElementById('saveStatus');
    el.textContent = text;
    el.className = 'save-status' + (cls ? ' ' + cls : '');
  }

  function scheduleSave(){
    setStatus('جارِ الحفظ...', 'saving');
    clearTimeout(saveTimer);
    saveTimer = setTimeout(() => {
      setDoc(overridesRef, { items: overrides, updatedAt: Date.now() })
        .then(() => setStatus('✅ تم الحفظ — يظهر للزبائن الآن', 'saved'))
        .catch((e) => setStatus('⚠️ تعذّر الحفظ — تأكد من الإنترنت', 'error'));
    }, 500);
  }

  function render(){
    const wrap = document.getElementById('dishList');
    wrap.innerHTML = '';
    CAT_ORDER.forEach(catKey => {
      const dishes = CATALOG.filter(d => d.cat === catKey);
      if(!dishes.length) return;
      const block = document.createElement('div');
      block.className = 'cat-block';
      const title = document.createElement('div');
      title.className = 'cat-title';
      title.textContent = CAT_LABELS[catKey] || catKey;
      block.appendChild(title);
      dishes.forEach(d => {
        const ov = overrides[d.id] || {};
        const currentPrice = ov.price !== undefined ? ov.price : d.price;
        const soldOut = !!ov.soldOut;
        const row = document.createElement('div');
        row.className = 'dish-row' + (soldOut ? ' sold-out' : '');
        row.innerHTML = `
          <div class="dish-name">${d.name}</div>
          <div class="price-wrap">
            <input type="number" inputmode="decimal" value="${currentPrice}" data-price="${d.id}" aria-label="سعر ${d.name}">
