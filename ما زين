        `;
        wrap.appendChild(row);
      });
      wrap.appendChild(block);
    });

    wrap.querySelectorAll('[data-price]').forEach(inp => {
      inp.addEventListener('change', () => {
        const id = inp.dataset.price;
        const val = parseFloat(inp.value);
        if(isNaN(val) || val < 0) return;
        overrides[id] = overrides[id] || {};
        overrides[id].price = val;
        scheduleSave();
      });
    });
    wrap.querySelectorAll('[data-toggle]').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.toggle;
        overrides[id] = overrides[id] || {};
        overrides[id].soldOut = !overrides[id].soldOut;
        scheduleSave();
        render();
      });
    });
    wrap.querySelectorAll('[data-reset]').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.reset;
        delete overrides[id];
        scheduleSave();
        render();
      });
    });
  }

  onSnapshot(overridesRef, (snap) => {
    overrides = (snap.exists() && snap.data().items) ? snap.data().items : {};
    render();
  }, (err) => {
    setStatus('⚠️ تعذّر الاتصال بقاعدة البيانات', 'error');
    render();
  });

  render();
</script>

