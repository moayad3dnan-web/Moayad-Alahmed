<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>لوحة تحكم المالك — ديفان الخليج</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#FBF3E6; --surface:#F7EAD4; --ink:#3B2A1E; --ink-soft:#8A7259;
    --line:#E3D2AE; --accent-dark:#6E2A2A; --gold:#C8962A; --gold-tint:#F4E6C8; --gold-strong:#9C7218;
    --fresh:#3C8F4A; --urgent:#C0392B;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html,body{ background:var(--bg); color:var(--ink); font-family:'Cairo',sans-serif; -webkit-tap-highlight-color:transparent; }
  button{ font-family:'Cairo',sans-serif; cursor:pointer; transition:transform .12s ease; }
  button:active{ transform:scale(0.96); }
  input{ font-family:'Cairo',sans-serif; }

  /* ---------- PIN gate (same proven pattern as staff tools) ---------- */
  body.pin-locked > *:not(.pin-gate){ display:none !important; }
  .pin-gate{
    position:fixed; inset:0; z-index:200; background:#181209; display:flex; flex-direction:column;
    align-items:center; justify-content:center; padding:30px 20px; text-align:center;
  }
  .pin-gate h2{ font-family:'Aref Ruqaa',serif; font-size:24px; color:#E3B45C; margin-bottom:6px; }
  .pin-gate .sub{ color:#C2A98A; font-size:13px; margin-bottom:24px; }
  .pin-text-input{
    width:100%; max-width:280px; padding:16px; border-radius:14px; border:1.5px solid #3A2C1A;
    background:#221A10; color:#F2E9DA; font-size:22px; text-align:center; letter-spacing:8px; outline:none;
  }
  .pin-text-input:focus{ border-color:#E3B45C; }
  .pin-debug{ color:#8A7259; font-size:11px; margin-top:8px; }
  .pin-error{ color:#C0392B; font-size:12.5px; font-weight:700; margin-top:10px; display:none; min-height:16px; }
  .pin-submit{
    margin-top:18px; width:100%; max-width:280px; padding:14px; border-radius:14px; border:none;
    background:#E3B45C; color:#241a05; font-weight:800; font-size:15px;
  }

  /* ---------- dashboard ---------- */
  .db-header{ text-align:center; padding:24px 16px 10px; }
  .db-header h1{ font-family:'Aref Ruqaa',serif; font-size:24px; color:var(--gold-strong); }
  .db-header .sub{ font-size:12px; color:var(--ink-soft); margin-top:4px; }
  .save-status{ text-align:center; font-size:12px; font-weight:700; min-height:18px; margin-bottom:6px; }
  .save-status.saving{ color:var(--ink-soft); }
  .save-status.saved{ color:var(--fresh); }
  .save-status.error{ color:var(--urgent); }
  .cat-block{ max-width:560px; margin:0 auto; padding:0 16px 20px; }
  .cat-title{ font-weight:800; font-size:14px; color:var(--accent-dark); margin:18px 0 8px; }
  .dish-row{
    display:flex; align-items:center; gap:10px; background:var(--surface); border:1px solid var(--line);
    border-radius:14px; padding:10px 12px; margin-bottom:8px;
  }
  .dish-row.sold-out{ opacity:0.55; }
  .dish-name{ flex:1; font-weight:700; font-size:13.5px; min-width:0; }
  .price-wrap{ display:flex; align-items:center; gap:4px; }
  .price-wrap input{
    width:64px; padding:8px 6px; border-radius:10px; border:1px solid var(--line); background:var(--bg);
    color:var(--ink); font-size:13.5px; text-align:center; outline:none;
  }
  .price-wrap input:focus{ border-color:var(--gold); }
  .price-wrap .orig{ font-size:10.5px; color:var(--ink-soft); }
  .sold-toggle{
    padding:7px 10px; border-radius:10px; border:1px solid var(--line); background:var(--bg);
    font-size:11px; font-weight:700; color:var(--ink-soft); white-space:nowrap;
  }
  .sold-toggle.active{ background:var(--urgent); border-color:var(--urgent); color:#fff; }
  .reset-btn{
    padding:7px 9px; border-radius:10px; border:none; background:none; color:var(--ink-soft); font-size:15px;
  }
</style>
</head>
<body class="pin-locked">

<div class="pin-gate">
  <h2>🔒 لوحة تحكم المالك</h2>
  <div class="sub">أدخل رمز دخول المالك</div>
  <input type="password" id="pinTextInput" class="pin-text-input" inputmode="numeric" autocomplete="off" maxlength="6" placeholder="••••••">
  <div class="pin-debug" id="pinDebug">عدد الأرقام المكتوبة: 0</div>
  <div class="pin-error" id="pinError">رمز غير صحيح، حاول مرة ثانية</div>
  <button class="pin-submit" id="pinSubmit">دخول</button>
</div>
<script>
(function(){
  var OWNER_PIN = '550012';
  var STORAGE_KEY = 'diwaniya-owner-pin-ok';

  function unlockNow(){
    document.body.classList.remove('pin-locked');
    var gate = document.querySelector('.pin-gate');
    if(gate) gate.style.display = 'none';
  }
  try{ if(localStorage.getItem(STORAGE_KEY)==='1') unlockNow(); }catch(e){}

  function tryUnlock(){
    try{
      var input = document.getElementById('pinTextInput');
      var err = document.getElementById('pinError');
      var entered = (input && input.value ? input.value : '').replace(/[^0-9]/g, '');
      if(err){ err.style.display = 'block'; err.style.color = '#C0392B'; }
      if(entered === OWNER_PIN){
        try{ localStorage.setItem(STORAGE_KEY, '1'); }catch(e2){}
        if(err){ err.textContent = '✅ تطابق! جاري الفتح...'; err.style.color = '#3C8F4A'; }
        unlockNow();
      } else {
        if(err) err.textContent = 'رمز غير صحيح — كتبت ' + entered.length + ' رقم (المطلوب ' + OWNER_PIN.length + ')';
        if(input){ input.value = ''; input.focus(); }
        var dbg = document.getElementById('pinDebug');
        if(dbg) dbg.textContent = 'عدد الأرقام المكتوبة: 0';
      }
    }catch(fatalErr){
      var err2 = document.getElementById('pinError');
      if(err2){ err2.style.display = 'block'; err2.style.color = '#C0392B'; err2.textContent = 'خطأ برمجي: ' + fatalErr.message; }
    }
  }
  function wireUp(){
    var input = document.getElementById('pinTextInput');
    var btn = document.getElementById('pinSubmit');
    var dbg = document.getElementById('pinDebug');
    if(btn){
      btn.addEventListener('click', tryUnlock);
      btn.addEventListener('touchend', function(e){ e.preventDefault(); tryUnlock(); });
    }
    if(input){
      input.addEventListener('keydown', function(e){ if(e.key==='Enter') tryUnlock(); });
      input.addEventListener('input', function(){
        var err = document.getElementById('pinError');
        if(err) err.style.display = 'none';
        if(dbg) dbg.textContent = 'عدد الأرقام المكتوبة: ' + input.value.replace(/[^0-9]/g,'').length;
      });
      setTimeout(function(){ input.focus(); }, 100);
    }
  }
  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', wireUp);
  } else {
    wireUp();
  }
})();
</script>

